# Bash entry point must retain Unix line endings on Windows.
*.sh text eol=lf
# Preserve archived record bytes and editable figure source.
reference/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
reference/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
reference/*.npz -text
figures/*.drawio -text
